// Document Templates block (core). Phase 3a builds the basics: each
// company's branding on documents, and rendering to PDF. The template
// editor (elements, multiple templates, versions) comes later
// (docs/templates-block.md).

/// How a company's documents look, and the details printed on them.
model DocTheme {
  companyId     String   @id
  logoFileId    String?
  /// Headings, table header and totals bar: "#1f6feb".
  accentColor   String   @default("#b45309")
  /// Printed under the business name.
  phone         String?
  email         String?
  /// The address in parts (docs/stage-2-projects.md "Addresses"); `address` is the one line made from them.
  address       String?
  /// Unit, number and street: "2/12 Smith St".
  street        String?
  suburb        String?
  /// "VIC".
  state         String?
  postcode      String?
  /// "Australia", or another country's name.
  country       String?
  /// Google's id for the place, when picked from Google.
  placeId       String?
  latitude      Float?
  longitude     Float?
  website       String?
  /// e.g. "REC" (Victorian electrical licence) or "Licence no."
  licenceLabel  String?
  licenceNumber String?
  /// Small print at the bottom of every page.
  footerText    String?
  updatedAt     DateTime @updatedAt
}
