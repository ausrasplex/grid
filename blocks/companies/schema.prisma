// Companies block: businesses, their roles, who works for them, and
// which optional blocks each company has switched on.

enum MembershipStatus {
  INVITED
  ACTIVE
  REMOVED
}

model Company {
  id           String       @id @default(uuid())
  name         String
  abn          String?
  /// A trade id from trades.ts (ELECTRICAL, SOLAR, TILING…). Text, not an enum, so new trades need no migration.
  tradeProfile String
  /// { branding: {...}, units: "metric", workingHours: {...}, features: {...} }
  settings     Json         @default("{}")
  /// The business picture: a square JPEG (pictures/company/<id>/…), shown
  /// for the business and as the team's profile picture until each person
  /// adds their own. Made from the Branding logo until one is uploaded here.
  logoKey      String?
  /// The picture was made from the Branding logo (a new logo replaces it);
  /// false once someone uploads a picture of its own.
  logoFromBranding Boolean @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  /// Deleted by an Owner or the server admin: hidden from everyone, restorable
  /// until the storage clean-up removes it for good (after Recently deleted runs out).
  deletedAt    DateTime?
  deletedById  String?
  /// Removed for good: everything in it is gone. The row stays (name only) for the history.
  purgedAt     DateTime?

  roles       Role[]
  memberships Membership[]
  blocks      CompanyBlock[]
}

/// A named bundle of permission strings. System roles (OWNER, FOREMAN,
/// EMPLOYEE, VIEWER) are created for every company and kept in sync with
/// the blocks' grants; custom roles are edited by the company.
model Role {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  /// "OWNER" | "FOREMAN" | "EMPLOYEE" | "VIEWER" for built-in roles, null for custom
  systemRole  String?
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id])
  memberships Membership[]

  @@unique([companyId, name])
  @@unique([companyId, systemRole])
}

/// A user's employment in a company. One person can belong to several.
model Membership {
  id        String           @id @default(uuid())
  userId    String
  companyId String
  roleId    String
  status    MembershipStatus @default(INVITED)
  invitedBy String?
  /// The invite's join link (/join/<token>), for sending by hand when the
  /// server has no email. The hash finds it; the encrypted copy lets the
  /// Owner see and copy the link again. Cleared once used.
  inviteTokenHash String?   @unique
  inviteTokenEnc  String?
  inviteExpiresAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  role    Role    @relation(fields: [roleId], references: [id])

  @@unique([userId, companyId])
  @@index([companyId, status])
}

/// Which optional blocks a company has switched on. Required blocks
/// are always on and never stored here.
model CompanyBlock {
  companyId String
  blockId  String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@id([companyId, blockId])
}

// ─── Leave and time off ─────────────────────────────────────────────────
// One set of records for a person's time away, shared by the Scheduling
// Block's time off (solo: saved as approved, blocks out booking) and the
// Leave Block's requests (teams, phase 7: pending, approved by an Owner,
// the leave calendar). Kept here in core so neither optional Block has to
// depend on the other (docs/roadmap.md "Leave"). Dates only, no balances.

enum LeaveType {
  ANNUAL
  PERSONAL
  COMPASSIONATE
  LONG_SERVICE
  PARENTAL
  COMMUNITY_SERVICE
  UNPAID
  RDO
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

/// Which part of the first or last day: all of it, the morning (before
/// midday), the afternoon (from midday) or some hours (Leave Block, later).
enum DayPart {
  WHOLE
  MORNING
  AFTERNOON
  HOURS
}

model Leave {
  id              String      @id @default(uuid())
  companyId       String
  /// Whose time away it is.
  userId          String
  type            LeaveType   @default(ANNUAL)
  /// Local dates, both included: no time part, so they never shift with timezones.
  startsOn        DateTime    @db.Date
  endsOn          DateTime    @db.Date
  firstDayPart    DayPart     @default(WHOLE)
  lastDayPart     DayPart     @default(WHOLE)
  /// Hours away on the first or last day when its part is HOURS.
  firstDayHours   Decimal?    @db.Decimal(4, 2)
  lastDayHours    Decimal?    @db.Decimal(4, 2)
  /// Private to the person and whoever approves it.
  note            String?
  /// Time off saved while solo is approved straight away; requests start PENDING.
  status          LeaveStatus @default(APPROVED)
  decidedByUserId String?
  decidedAt       DateTime?
  declineReason   String?
  createdByUserId String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([companyId, userId, startsOn])
  @@index([companyId, startsOn])
}

