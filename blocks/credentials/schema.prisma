/// One of a person's tickets or licences (My tickets & licences). Belongs to
/// the person (userId), not a business: kept when they change or leave one,
/// and seen only by them until sharing comes (phase 9).
model Credential {
  id          String    @id @default(uuid())
  userId      String
  /// From TICKET_TYPES (types.ts), e.g. "white-card", "ewp", "other".
  type        String
  /// Extra words: the class ("A-grade"), or the name for "other".
  name        String    @default("")
  /// The card or licence number, encrypted (encryptSecret).
  numberEnc   String?
  /// Who issued it ("WorkSafe Victoria") or the state.
  issuer      String?
  issuedOn    DateTime? @db.Date
  /// Empty for one that doesn't expire.
  expiresOn   DateTime? @db.Date
  /// Photos of the card (StoredFile, block credentials).
  frontFileId String?
  backFileId  String?
  notes       String?
  /// The last reminder emailed, in days before expiry (60, 30, 7, 0). Cleared when the date changes.
  remindedAt  Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([userId, deletedAt])
  @@index([expiresOn])
}
