// Markups block (phase 4b): your own drawing over a plan sheet (pen,
// highlighter, text, shapes, arrows, clouds) and measuring (length and
// area). Design: docs/plans-block.md.
//
// Points are in sheet units (x 0 → 1 across the sheet's width), so a markup
// drawn on Rev B lands in the same spot on Rev C: markups carry over to
// newer revisions of the sheet.

enum MarkupKind {
  PEN
  HIGHLIGHT
  TEXT
  LINE
  ARROW
  RECT
  ELLIPSE
  CLOUD
  LENGTH
  AREA
  /// A trade symbol (phase 4c): iconKey from icons.ts, counted for take-offs.
  ICON
}

/// Who sees a markup (docs/roadmap.md rule 6). Solo businesses never see the choice.
enum MarkupVisibility {
  /// Only the person who drew it.
  JUST_ME
  /// Everyone in your business (the default).
  COMPANY
  /// Everyone on the job, up the contract chain (later).
  SHARED
}

model PlanMarkup {
  /// Made on the device, so a retried save never makes a second copy.
  id          String           @id
  companyId   String
  projectId   String
  sheetId     String
  /// The revision it was drawn on. It also shows on every newer revision.
  versionId   String
  kind        MarkupKind
  /// [[x, y], …] in sheet units.
  points      Json
  /// Ink name: red, blue, green, yellow, magenta, black.
  color       String
  /// Line width, or text height, in sheet units.
  size        Float
  text        String?
  /// ICON: which symbol ("electrical.gpo-double") and its number on this job (null = 1; JobIconVersion).
  iconKey     String?
  iconNumber  Int?
  visibility  MarkupVisibility @default(COMPANY)
  createdById String
  createdAt   DateTime         @default(now())
  updatedById String?
  updatedAt   DateTime         @updatedAt
  /// Deleted markups stay (for Undo and the history); they're never shown.
  deletedAt   DateTime?
  deletedById String?

  @@index([sheetId, deletedAt])
  @@index([companyId, projectId])
  @@index([projectId, kind, deletedAt])
}

enum PlanScaleMethod {
  /// From the drawing's scale (1:100) and the PDF page size.
  RATIO
  /// Two points on the sheet and how far apart they really are.
  POINTS
}

/// How big a revision really is, for measuring. One per revision; a newer
/// revision without its own uses the last one set (and says so).
model PlanScale {
  versionId     String          @id
  companyId     String
  sheetId       String
  /// Real metres per sheet unit (one whole sheet width).
  metresPerUnit Float
  method        PlanScaleMethod
  /// RATIO: 100 for 1:100.
  ratio         Int?
  /// POINTS: the two points, and the length typed in.
  points        Json?
  knownMetres   Float?
  setById       String
  setAt         DateTime        @updatedAt

  @@index([sheetId])
}

/// Numbered versions of an icon on one job (phase 4c, decided Nov 2026):
/// DGPO 1 a standard double power point, DGPO 2 an expensive one. Set per
/// job only; nothing carries over from other jobs. A job with no rows for
/// an icon uses it unnumbered. Number 1 also covers icons placed before the
/// numbers were added (iconNumber null).
model JobIconVersion {
  id          String   @id @default(uuid())
  companyId   String
  projectId   String
  iconKey     String
  number      Int
  /// A short name shown on the chips and in the counts ("Standard", "Iconic").
  name        String?
  /// The price book item this number becomes on a quote (the quotes Block; phase 4c part 2).
  priceItemId String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, projectId, iconKey, number])
  @@index([projectId])
}

/// A business's own icon (phase 4c part 3), built like the built-in ones:
/// an outline and a short label, in its trade's colour. Placed with the key
/// "custom.<id>". Deleting hides it from the library; placed ones still draw.
model CustomIcon {
  id          String    @id @default(uuid())
  companyId   String
  /// A built-in trade id ("electrical"), or "custom".
  trade       String
  name        String
  words       String[]  @default([])
  /// circle | square | triangle | diamond | hexagon
  outline     String
  /// Up to 3 letters or numbers in the middle ("BL").
  label       String
  /// A picture instead of the outline and label: later.
  fileId      String?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([companyId, deletedAt])
}
