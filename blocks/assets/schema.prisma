// Assets block (docs/assets-block.md): the business's tools and gear, with
// QR tags. Part 1: assets, categories with their own fields, tags and the
// sticker sheets, scan to open. Part 2: custody (who has it, where it is)
// and the movement history. Part 3: faults (Do not use, the repair steps)
// and lost or stolen. Part 4: inspections and servicing (routines, the log
// of checks done, bookings). Part 4b: Docket's layout (warranty, value, brand, kit pieces,
// manuals and documents, copies). Vehicles add their tables later.

enum AssetStatus {
  IN_SERVICE
  FAULTY
  OUT_OF_SERVICE
  IN_REPAIR
  RETIRED
  LOST
  /// A routine that must be passed (test & tag) is past due.
  OVERDUE
}

/// A kind of gear (Power tools, Test equipment, Ladders…), per business.
model AssetCategory {
  id                     String    @id @default(uuid())
  companyId              String
  name                   String
  /// Its picture when an asset has no photo (ui/category-icons.ts key: "drill", "plug"…).
  icon                   String?
  /// The category's own fields, in order: [{ key, label, type: "text" | "number" | "date" | "yesno" }].
  fields                 Json      @default("[]")
  sort                   Int       @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?
  assets                 Asset[]
  routines               AssetRoutine[]

  @@index([companyId])
}

/// One thing the business owns and wants to keep track of.
model Asset {
  id                String         @id @default(uuid())
  companyId         String
  /// The friendly number on the sticker ("Asset No. 1234"), unique per business.
  number            Int
  categoryId        String?
  category          AssetCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name              String
  make              String?
  model             String?
  serial            String?
  purchasedOn       DateTime?      @db.Date
  /// The maker's warranty (Docket's "Warranty ends"), and where it was bought.
  warrantyEndsOn    DateTime?      @db.Date
  supplier          String?
  /// What was paid, and what it would cost to replace (the asset register).
  purchasePrice     Decimal?       @db.Decimal(12, 2)
  replacementValue  Decimal?       @db.Decimal(12, 2)
  /// This exact model on the maker's site; the page falls back to the brand's support site.
  productUrl        String?
  /// The brand in Materials (MaterialBrand): its support site and phone show on the page. `make` keeps the name as typed.
  brandId           String?
  /// Shows "Kit pieces". Stays on while it has any.
  partsEnabled      Boolean        @default(false)
  /// Copies of the same model (Duplicate) share one id: manuals, warranties
  /// and links filed to one show on all of them; receipts, certificates and photos stay per copy.
  docSetId          String?
  /// StoredFile ids (block assets); the first is the main photo.
  photoFileIds      String[]       @default([])
  notes             String?
  /// The category's fields, filled in: { [key]: string | number | boolean }.
  fields            Json           @default("{}")
  status            AssetStatus    @default(IN_SERVICE)
  /// The QR tag's code (a RouteCode, blockId assets): random, unique across
  /// every server. "New tag" replaces it and the old sticker stops working.
  tagCode           String         @unique
  /// A barcode sticker it already had, linked instead of (or as well as) the QR tag.
  barcode           String?
  /// The soonest due date of its must-pass routines (part 4, due.ts), kept
  /// so lists, Home and the morning check don't work it out every time.
  nextInspectionDue DateTime?      @db.Date
  /// Shows "Inspections and servicing" on its page. Stays on while its category has routines.
  serviceEnabled    Boolean        @default(true)
  /// "Not seen recently" (part 5).
  lastSeenAt        DateTime?
  /// Containers (vehicles, §11): the van or toolbox it's in.
  parentAssetId     String?
  createdById       String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?
  custody           AssetCustody[]
  faults            AssetFault[]
  losses            AssetLoss[]
  routines          AssetRoutine[]
  checks            AssetCheck[]
  bookings          AssetBooking[]
  parts             AssetPart[]
  documents         AssetDocument[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, barcode])
  @@index([docSetId])
  @@index([categoryId])
}

/// A business's asset settings. Stored now for later parts (§2, §10).
model AssetSettings {
  companyId         String   @id
  /// "Not seen recently" after this many days (part 5).
  notSeenDays       Int      @default(30)
  /// The public tag page (§10): on, whether Lost shows, and what it shows ("NAME" or "OWNER").
  publicLookup      Boolean  @default(true)
  showLostPublicly  Boolean  @default(true)
  publicFields      String   @default("NAME")
  /// The sticker layout picked last ("a4-21", "a4-65", "label-62x29", "custom"; sticker-layouts.ts).
  stickerLayout     String   @default("a4-21")
  /// A Custom layout typed off the packet (CustomLayoutInput).
  stickerCustom     Json?
  /// Moves every sticker, in mm, for a printer that prints a little off.
  stickerOffsetX    Float    @default(0)
  stickerOffsetY    Float    @default(0)
  updatedAt         DateTime @updatedAt
}

enum AssetHolder {
  /// The workshop, yard or store (label: "Workshop").
  STORE
  /// Left on a job: projectId, and the building or level when picked.
  PROJECT
  /// With a person (userId), and the job they took it to when picked.
  USER
  /// In a van, by its name (label: "Van 3"). Becomes ASSET when vans are assets (§11).
  VEHICLE
  /// Inside another asset (a van, a toolbox): later, §11.
  ASSET
}

enum AssetMove {
  CHECK_OUT
  RETURN
  TAKE_OVER
  MOVE
}

/// Where an asset is, and who has it: one row per move. The current one has
/// no toAt. No row at all means it's in the workshop, never moved.
model AssetCustody {
  id         String      @id @default(uuid())
  companyId  String
  assetId    String
  asset      Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  holderType AssetHolder
  userId     String?
  projectId  String?
  siteId     String?
  buildingId String?
  levelId    String?
  /// The store's or van's name.
  label      String?
  /// The job and area as they were called then ("ED Refurbish · Tower B Level 5"), for the history.
  placeName  String?
  /// Inside this asset (holderType ASSET, later).
  parentId   String?
  move       AssetMove
  note       String?
  fromAt     DateTime    @default(now())
  toAt       DateTime?
  byUserId   String

  @@index([assetId, fromAt])
  @@index([companyId, toAt])
  @@index([userId, toAt])
  @@index([projectId, toAt])
}

enum AssetFaultType {
  FAULTY
  DAMAGED
  MISSING_PARTS
  FAILED_TEST
  OTHER
}

enum AssetFaultStatus {
  REPORTED
  ACKNOWLEDGED
  IN_REPAIR
  FIXED
  RETIRED
}

/// A fault reported on an asset (§3). Open until FIXED or RETIRED. The
/// asset's status follows its open faults (status.ts).
model AssetFault {
  id           String             @id @default(uuid())
  companyId    String
  assetId      String
  asset        Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type         AssetFaultType
  /// Unsafe: the asset is Do not use until the fault is closed.
  doNotUse     Boolean            @default(false)
  note         String?
  /// StoredFile ids (block assets).
  photoFileIds String[]           @default([])
  status       AssetFaultStatus   @default(REPORTED)
  reportedById String
  reportedAt   DateTime           @default(now())
  /// Where it was, from its custody when reported.
  projectId    String?
  siteId       String?
  buildingId   String?
  levelId      String?
  placeName    String?
  /// Only when the reporter allowed their location.
  lat          Float?
  lng          Float?
  closedAt     DateTime?
  updatedAt    DateTime           @updatedAt
  events       AssetFaultEvent[]

  @@index([assetId, closedAt])
  @@index([companyId, closedAt])
}

/// Each step of a fault: reported, acknowledged, in repair, fixed or
/// retired, or a note added (status null), with who and when.
model AssetFaultEvent {
  id           String            @id @default(uuid())
  faultId      String
  fault        AssetFault        @relation(fields: [faultId], references: [id], onDelete: Cascade)
  status       AssetFaultStatus?
  note         String?
  photoFileIds String[]          @default([])
  /// Set when this step made it Do not use (an "Add to existing report" that's unsafe).
  doNotUse     Boolean           @default(false)
  byUserId     String
  at           DateTime          @default(now())

  @@index([faultId, at])
}

enum AssetLossKind {
  LOST
  STOLEN
}

/// Reported lost or stolen (§3a). Open until recovered or retired as lost.
model AssetLoss {
  id               String        @id @default(uuid())
  companyId        String
  assetId          String
  asset            Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  kind             AssetLossKind
  /// Last known whereabouts as the reporter confirmed them ("With Sam T., ED Refurbish, Tue 7:02 am").
  lastKnown        String?
  note             String?
  /// Stolen: the police report number, for insurance.
  policeReport     String?
  reportedById     String
  reportedAt       DateTime      @default(now())
  recoveredAt      DateTime?
  recoveredById    String?
  /// Retired as lost (Owner): off the active list, history and tag kept.
  retiredAt        DateTime?
  retiredById      String?
  updatedAt        DateTime      @updatedAt

  @@index([assetId])
  @@index([companyId, recoveredAt, retiredAt])
}

/// Something done to gear on a schedule (§4): test & tag, a harness or
/// ladder inspection, a service, calibration. Set on a category (every
/// asset in it follows, and changes flow to them) or on one asset.
model AssetRoutine {
  id          String         @id @default(uuid())
  companyId   String
  categoryId  String?
  category    AssetCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  assetId     String?
  asset       Asset?         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  name        String
  /// Every so many months; null for one with no set interval.
  everyMonths Int?
  /// Must be passed to use it: once overdue the asset is Overdue and can't be checked out.
  mustPass    Boolean        @default(false)
  notes       String?
  sort        Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  @@index([companyId])
  @@index([categoryId])
  @@index([assetId])
}

enum AssetCheckResult {
  PASS
  FAIL
}

/// One test, inspection or service done (the log, §4). Covers one or more
/// routines; a pass restarts their countdown. A fail opens a Failed test
/// fault, Do not use.
model AssetCheck {
  id         String           @id @default(uuid())
  companyId  String
  assetId    String
  asset      Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  /// AssetRoutine ids it covered.
  routineIds String[]         @default([])
  /// What was done ("Test & tag", "12-month service").
  title      String
  result     AssetCheckResult @default(PASS)
  /// Who did it: the tester, the business or the person ("Spark Safe Testing").
  doneBy     String?
  /// Test & tag colour for the period it was done in (RED, GREEN, BLUE, YELLOW).
  tagColour  String?
  cost       Decimal?         @db.Decimal(12, 2)
  /// StoredFile ids (block assets): certificates, photos, invoices.
  fileIds    String[]         @default([])
  notes      String?
  /// The Failed test fault it opened.
  faultId    String?
  byUserId   String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  deletedAt  DateTime?

  @@index([assetId, date])
  @@index([companyId])
}

/// A test or service booked in (§4): it shows as the next date until it's
/// logged or called off.
model AssetBooking {
  id         String    @id @default(uuid())
  companyId  String
  assetId    String
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  routineIds String[]  @default([])
  date       DateTime  @db.Date
  /// Where or who ("Spark Safe Testing, Dandenong").
  withWho    String?
  byUserId   String
  createdAt  DateTime  @default(now())
  /// Logged (a check was recorded for it) or cancelled ("It didn't happen").
  closedAt   DateTime?
  closedHow  String?

  @@index([assetId, closedAt])
}

/// A piece of a kit (Docket's Parts): the batteries, charger and case that
/// come with a drill, each with its own model, serial and warranty. Not
/// tagged or listed on its own; tag it as its own asset if it moves alone.
model AssetPart {
  id             String          @id @default(uuid())
  companyId      String
  assetId        String
  asset          Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  name           String
  make           String?
  model          String?
  serial         String?
  warrantyEndsOn DateTime?       @db.Date
  /// A StoredFile id (block assets).
  photoFileId    String?
  notes          String?
  sort           Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  documents      AssetDocument[]

  @@index([assetId])
}

enum AssetDocumentKind {
  MANUAL
  WARRANTY
  LINK
  RECEIPT
  CERTIFICATE
  PHOTO
  OTHER
}

/// Manuals, links and documents (Docket's card of the same name): a file
/// or a link, on the whole asset or one kit piece. Manuals, warranties and
/// links are shared by its copies (docSetId).
model AssetDocument {
  id          String            @id @default(uuid())
  companyId   String
  assetId     String
  asset       Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  partId      String?
  part        AssetPart?        @relation(fields: [partId], references: [id], onDelete: Cascade)
  kind        AssetDocumentKind
  title       String
  /// A StoredFile id (block assets), or a link.
  fileId      String?
  url         String?
  sort        Int               @default(0)
  createdById String
  createdAt   DateTime          @default(now())
  deletedAt   DateTime?

  @@index([assetId])
  @@index([partId])
}
