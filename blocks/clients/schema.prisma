/// Who the work is for: a homeowner, property manager, builder… One list
/// for the whole business: jobs (Project.clientId) and quotes (Quote.clientId)
/// both point here. Removing a client keeps it for the jobs and quotes that
/// already name it.
///
/// A client can be a person at a business (`businessId`): Sam Lee, Project
/// Manager at Honeywell. Quotes and jobs still go to the person; the business
/// holds the ABN and the office address and phone, used when the person has
/// none of their own.
model Client {
  id          String    @id @default(uuid())
  companyId   String
  name        String
  /// Older clients: the person to ask for. People at a business don't use it.
  contactName String?
  /// The business they work for, if any.
  businessId  String?
  business    ClientBusiness? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  /// Their role there: "Project Manager", "Service Technician".
  role        String?
  email       String?
  phone       String?
  /// The address in parts (docs/stage-2-projects.md "Addresses"); `address` is the one line made from them.
  address     String?
  /// Unit, number and street: "2/12 Smith St".
  street      String?
  suburb      String?
  /// "VIC".
  state       String?
  postcode    String?
  /// "Australia", or another country's name.
  country     String?
  /// Google's id for the place, when picked from Google.
  placeId     String?
  latitude    Float?
  longitude   Float?
  /// Business number (ABN etc.) for business clients.
  abn         String?
  notes       String?
  /// Later (contract chain): the Grid account this contact card is for,
  /// matched by email. Stored now, empty and unread until then.
  linkedUserId String?
  /// Their photo (pictures/clients/<companyId>/…). None: their business's logo, then initials.
  photoKey    String?
  /// How they found you (Google, Word of mouth, Referral…): the business's own list, LeadSource.
  /// Optional. Feeds the Analytics Block's Lead sources (docs/quotations-block.md "Lead source").
  leadSourceId String?
  leadSource   LeadSource? @relation(fields: [leadSourceId], references: [id], onDelete: SetNull)
  /// Referral: the client who sent them your way.
  referredByClientId String?
  referredBy         Client?  @relation("ClientReferrals", fields: [referredByClientId], references: [id], onDelete: SetNull)
  referred           Client[] @relation("ClientReferrals")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([companyId, name])
  @@index([businessId])
  @@index([leadSourceId])
  @@index([referredByClientId])
}

/// How clients find a business: one editable list per business, started with
/// Google, Facebook/Instagram, Word of mouth, Referral, Van signage, Builder,
/// Repeat client and Other the first time it's needed. Hidden, not deleted, so
/// past clients and jobs keep theirs (docs/quotations-block.md "Lead source").
model LeadSource {
  id         String    @id @default(uuid())
  companyId  String
  name       String
  /// The one that asks "Who referred them?" (a client of yours).
  isReferral Boolean   @default(false)
  sortOrder  Int       @default(0)
  /// Hidden from the list for new clients; kept on the ones that already have it.
  hiddenAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  clients    Client[]

  @@unique([companyId, name])
  @@index([companyId, sortOrder])
}

/// A business some of your clients work for (Honeywell). Holds what's the
/// same for all of them: ABN, office address, main phone and email.
model ClientBusiness {
  id        String    @id @default(uuid())
  companyId String
  name      String
  abn       String?
  email     String?
  phone     String?
  /// The address in parts (docs/stage-2-projects.md "Addresses"); `address` is the one line made from them.
  address   String?
  /// Unit, number and street: "2/12 Smith St".
  street    String?
  suburb    String?
  /// "VIC".
  state     String?
  postcode  String?
  /// "Australia", or another country's name.
  country   String?
  /// Google's id for the place, when picked from Google.
  placeId   String?
  latitude  Float?
  longitude Float?
  notes     String?
  /// Later (contract chain): the Grid business this contact card is for,
  /// matched by ABN. Stored now, empty and unread until then.
  linkedCompanyId String?
  /// The business's logo (pictures/clients/<companyId>/…), also shown for its people without a photo.
  logoKey   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  people    Client[]

  @@index([companyId, name])
}
