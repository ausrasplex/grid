// Plans block (phase 4a): a job's drawing sheets and their revisions.
// A sheet is "E-101 Lighting Layout"; each upload of it is a PlanVersion
// (Rev A, B…). The newest is current unless someone picks another. Each
// version is rendered once to deep-zoom tiles (<files>/.cache/plans/<id>)
// for the viewer; the original PDF or image stays as uploaded.

enum PlanVersionStatus {
  PENDING
  READY
  FAILED
}

model PlanSheet {
  id               String    @id @default(uuid())
  companyId        String
  projectId        String
  /// As on the drawing: "E-101", "E1.01".
  number           String
  title            String    @default("")
  /// Discipline code from the number's letters: E, M, H, A, S, F… ("" when unknown).
  discipline       String    @default("")
  /// Optional: the level it shows, so the job page can offer it on that level.
  buildingId       String?
  levelId          String?
  currentVersionId String?
  /// How sharp this sheet is drawn (LOW | MEDIUM | HIGH | EXTREME), or null
  /// for the server's Plans level (Settings › Plans & PDFs).
  quality          String?
  createdById      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  deletedById      String?
  purgedAt         DateTime?

  versions PlanVersion[]

  @@index([projectId, deletedAt])
  @@index([companyId, deletedAt])
}

model PlanVersion {
  id           String            @id @default(uuid())
  sheetId      String
  /// "C", "P2", "3"; "" when the upload didn't say.
  revision     String            @default("")
  /// The uploaded PDF or image (several versions can share one PDF: one per page).
  fileId       String
  page         Int               @default(1)
  status       PlanVersionStatus @default(PENDING)
  error        String?
  /// Rendered size in pixels, and the dots per inch used (for measuring in 4b).
  widthPx      Int?
  heightPx     Int?
  dpi          Int?
  /// The PDF page size in points (1/72 inch), when it came from a PDF.
  pageWidthPt  Float?
  pageHeightPt Float?
  note         String?
  /// Bytes the tiles and thumbnail take in the cache (null: drawn before sizes were
  /// recorded; "plans.measure" fills it in overnight). docs/stage-2-projects.md "Job storage".
  cacheBytes   Int?
  /// The tiles were removed because the job is archived (the thumbnail stays).
  /// Opening the sheet draws them again.
  tilesDroppedAt DateTime?
  /// Last opened in the viewer while the job is archived: the redrawn tiles
  /// go again after Settings › Storage › "Keep redrawn copies" days.
  openedAt       DateTime?
  uploadedById String
  createdAt    DateTime          @default(now())

  sheet PlanSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@index([sheetId, createdAt])
  @@index([fileId])
}

/// A layer on a plan sheet (Nov 2026, docs/plans-block.md "Layers"):
/// Power, Data, Lighting; Water, Drainage. Markups, icons and photo pins
/// each sit on one (their `layerId`), or on Default (null), which every sheet
/// has without a row. Each person turns layers on and off for themselves
/// (on their device). Deleting a layer puts what was on it back on Default.
model PlanLayer {
  id          String    @id @default(uuid())
  companyId   String
  sheetId     String
  name        String
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([sheetId, deletedAt])
}

/// A private link to some of a job's plan sheets, for someone without a
/// Grid account (Nov 2026, docs/plans-block.md "Sharing plans"): /s/<token>.
/// Always shows each sheet's current revision, with the chosen layers'
/// markups and icons drawn on. Works until it runs out or is turned off.
model PlanShare {
  id            String    @id @default(uuid())
  companyId     String
  projectId     String
  /// Who it's for, e.g. "Smith Builders site office".
  name          String
  /// The token is in the link; stored hashed (to find it) and encrypted (to show the link again).
  tokenHash     String    @unique
  tokenEnc      String
  /// PlanSheet ids, in the order chosen.
  sheetIds      Json
  /// PlanLayer ids whose markups and icons show, and whether Default's do.
  layerIds      Json
  withDefault   Boolean   @default(true)
  allowDownload Boolean   @default(true)
  /// Null: never runs out.
  expiresAt     DateTime?
  revokedAt     DateTime?
  revokedById   String?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastOpenedAt  DateTime?
  openCount     Int       @default(0)

  @@index([projectId, revokedAt])
  @@index([companyId])
}
