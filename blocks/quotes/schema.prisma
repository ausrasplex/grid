// Quotes block (docs/quotations-block.md). Phase 3a: tax settings, clients,
// price book, quick quotes, revisions, accept → job. Signing comes in 3b.
// Money is Decimal(12,2) in dollars; maths happens in cents (money.ts).

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

enum PriceItemKind {
  LABOUR
  MATERIAL
}

/// How much detail the customer sees.
enum QuoteClientView {
  ITEMISED
  SECTIONS
  LUMP
}

/// One per company: tax name, codes, currency (§3a). Nothing assumes GST.
model TaxSettings {
  companyId          String   @id
  taxName            String   @default("GST")
  pricesIncludeTax   Boolean  @default(false)
  registrationLabel  String   @default("ABN")
  currency           String   @default("AUD")
  locale             String   @default("en-AU")
  /// "LINE" | "TOTAL"
  rounding           String   @default("LINE")
  documentTitle      String   @default("Quote")
  defaultTaxCodeId   String?
  quotePrefix        String   @default("Q-")
  validityDays       Int      @default(30)
  defaultTerms       String?
  /// Quote emails include a link where the customer can view, sign or decline.
  onlineAccept       Boolean  @default(true)
  /// How customers may sign: drawing and/or typing their name.
  signDrawn          Boolean  @default(true)
  signTyped          Boolean  @default(true)
  updatedAt          DateTime @updatedAt
}

/// One person's own quote screen settings, in one business (Settings › You ›
/// Quote screen). Only that person sees or changes them.
model QuoteUserSettings {
  companyId  String
  userId     String
  /// Swiping a line on the quote screen (swipe.ts): OFF | DELETE | DUPLICATE | OPTIONAL | SECTION | QTY_UP.
  swipeLeft  String   @default("DELETE")
  swipeRight String   @default("DUPLICATE")
  updatedAt  DateTime @updatedAt

  @@id([companyId, userId])
}

model TaxCode {
  id        String   @id @default(uuid())
  companyId String
  name      String
  /// Short, on documents: "GST", "GST-free"
  label     String
  /// 0.1000 = 10%
  rate      Decimal  @db.Decimal(6, 4)
  active    Boolean  @default(true)
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  /// Deleted from Settings › Tax & currency: hidden everywhere, but kept so
  /// quotes already sent with it still add up.
  deletedAt DateTime?

  @@index([companyId])
}

model PriceItem {
  id           String        @id @default(uuid())
  companyId    String
  kind         PriceItemKind
  name         String
  /// "each", "hr", "m"…
  unit         String        @default("each")
  cost         Decimal?      @db.Decimal(12, 2)
  sell         Decimal       @db.Decimal(12, 2)
  taxCodeId    String?
  supplier     String?
  supplierCode String?
  /// The make (Clipsal, HPM…), from the business's Brands list.
  brandId      String?
  brand        PriceBrand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  /// Shown first when adding to a quote on the phone.
  favourite    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  @@index([companyId, kind])
  @@index([brandId])
  @@index([companyId, supplierCode])
}

/// A supplier whose price list the business imports (docs/quotations-block.md
/// "Supplier price lists"): which columns of their file hold what, saved by
/// heading so next month's file goes straight in even if the columns move.
model SupplierPriceList {
  id             String    @id @default(uuid())
  companyId      String
  /// As it's written on price book items' Supplier ("MMEM", "Rexel").
  supplier       String
  /// Heading text per field: { code, description, cost, per, unit, brand }.
  columns        Json
  /// What to do with sell prices when a cost changes: KEEP_MARKUP or KEEP_SELL.
  sellPrices     String    @default("KEEP_MARKUP")
  /// Markup % for items added from the list (null: sell at cost).
  newItemMarkup  Decimal?  @db.Decimal(7, 2)
  lastImportedAt DateTime?
  lastFileName   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([companyId])
}

/// A price book item's cost or sell price changing, for its price history:
/// from a supplier price list, or edited by hand. Kept when the item is deleted.
model PriceChange {
  id          String   @id @default(uuid())
  companyId   String
  priceItemId String
  costBefore  Decimal? @db.Decimal(12, 2)
  costAfter   Decimal? @db.Decimal(12, 2)
  sellBefore  Decimal? @db.Decimal(12, 2)
  sellAfter   Decimal? @db.Decimal(12, 2)
  /// IMPORT (a supplier price list), EDIT (changed in the price book) or ADDED (new from a list).
  source      String
  /// The supplier and file, for an import.
  supplier    String?
  fileName    String?
  changedById String
  changedAt   DateTime @default(now())

  @@index([priceItemId, changedAt])
  @@index([companyId, changedAt])
}

/// A make you buy (Clipsal, HPM, Schneider…). Price book items pick one and
/// the price book filters by it. Removing a brand leaves its items unbranded.
model PriceBrand {
  id        String      @id @default(uuid())
  companyId String
  name      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?
  items     PriceItem[]

  @@index([companyId])
}

model Quote {
  id               String          @id @default(uuid())
  companyId        String
  /// "Q-1001": unique per company.
  number           String
  title            String
  /// Who it's for: a Client (clients block).
  clientId         String?
  siteAddress      String?
  /// Where it is, when it was started from a site, building or floor: the
  /// job it becomes goes there (covering that building or floor).
  siteId           String?
  buildingId       String?
  levelId          String?
  status           QuoteStatus     @default(DRAFT)
  clientView       QuoteClientView @default(ITEMISED)
  pricesIncludeTax Boolean
  validUntil       DateTime
  intro            String?
  terms            String?
  /// Never on the PDF.
  internalNotes    String?
  /// Materials markup: when on, every material line with a cost is priced at
  /// cost + this % (the line's own price is kept for when it's switched off).
  /// Set per quote; the client only ever sees the resulting prices.
  materialsMarkup    Boolean       @default(false)
  materialsMarkupPct Decimal?      @db.Decimal(7, 2)
  /// A quote made outside Grid: its PDF (StoredFile, block quotes) and the
  /// total written on it (including tax). It has no lines and no revisions;
  /// Grid tracks its answer and makes the job like any other quote.
  uploadedFileId   String?
  uploadedTotal    Decimal?        @db.Decimal(12, 2)
  /// The job it became (or was quoted for).
  projectId        String?
  createdById      String
  sentAt           DateTime?
  /// First time the customer opened the link for the current revision.
  viewedAt         DateTime?
  acceptedAt       DateTime?
  /// "RECORDED_BY_STAFF" now; "SIGNED_ONLINE" etc. with signing (3b).
  acceptedHow      String?
  acceptedNote     String?
  /// Optional extras the customer chose when accepting (line indexes in the signed revision).
  acceptedOptions  Json?
  /// The SignRequest that accepted it, when signed online.
  signRequestId    String?
  declinedAt       DateTime?
  declineReason    String?
  currentRevisionId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  lines     QuoteLine[]
  revisions QuoteRevision[]
  events    QuoteEvent[]

  @@unique([companyId, number])
  @@index([companyId, status])
}

/// The lines being edited. Sending copies them into a revision.
model QuoteLine {
  id          String   @id @default(uuid())
  quoteId     String
  sort        Int
  section     String?
  priceItemId String?
  /// Labour or material (from the price book item, or picked); null is Other.
  /// The materials markup only prices MATERIAL lines.
  kind        PriceItemKind?
  description String
  qty         Decimal  @db.Decimal(12, 3)
  unit        String   @default("each")
  cost        Decimal? @db.Decimal(12, 2)
  sell        Decimal  @db.Decimal(12, 2)
  taxCodeId   String?
  optional    Boolean  @default(false)
  /// Made by the take-off from plans (phase 4c): which icon and number it
  /// counts ("electrical.gpo-double#2"), so a changed count can update it.
  takeoffKey  String?

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, sort])
}

/// What was sent: Rev A, B… Read-only. The snapshot has the lines, client,
/// totals, tax settings and business details as they were, so changing
/// settings later never changes a quote already sent.
model QuoteRevision {
  id        String   @id @default(uuid())
  quoteId   String
  label     String
  snapshot  Json
  pdfFileId String?
  sentAt    DateTime @default(now())
  sentById  String
  /// Email address it was emailed to, or null if marked sent by hand.
  sentTo    String?

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model QuoteEvent {
  id       String   @id @default(uuid())
  quoteId  String
  /// CREATED | SENT | ACCEPTED | DECLINED | WITHDRAWN | REOPENED | JOB_CREATED
  type     String
  byUserId String?
  note     String?
  at       DateTime @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, at])
}
