# Grid settings.
#
# On Unraid you don't need this file: every setting below is a field in the
# Unraid template (unraid/grid.xml, guide in docs/unraid.md).
# With docker compose or for development: copy to .env and fill in.
# Never commit .env. `pnpm test` checks this file and the template list the
# same settings.

# --- Database -------------------------------------------------------------
# Either the parts (the container builds the address)…
DB_HOST=grid-postgres
DB_PASSWORD=change-me
DB_PORT=5432
DB_USER=grid
DB_NAME=grid
# …or a full address, which wins if set. For development, uncomment this.
# DATABASE_URL=postgresql://grid:change-me@localhost:5432/grid
# Used by the postgres service in docker-compose.yml (same as DB_PASSWORD).
POSTGRES_PASSWORD=change-me
# Update the database to match a new Grid version on each container start.
MIGRATE_ON_START=true

# --- Container ----------------------------------------------------------------
# Who Grid runs as and owns files as (Unraid: 99 = nobody, 100 = users).
PUID=99
PGID=100
# 022 = others can read new files; 002 = the group can also write.
UMASK=022
# Time zone: the nightly clean-up and backups run in it.
TZ=Australia/Melbourne

# --- Sign-in (Better Auth) ----------------------------------------------------
# Exactly the address people open Grid at, e.g. http://192.168.1.20:3000
# or https://grid.example.com.au.
BETTER_AUTH_URL=http://localhost:3000
# Other addresses Grid is opened at (comma-separated).
TRUSTED_ORIGINS=
# "invite" (default): only the first account can sign up; everyone else joins
# through an invite. "open": anyone can create an account.
SIGNUP_MODE=invite

# --- Secrets ------------------------------------------------------------------
# In the container, leave both blank: Grid makes them on first start and keeps
# them in /config/secrets.env (Unraid: appdata/grid). Back that file up.
# For development, generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET=
# Encrypts saved passwords (email, connections). Never change it once set.
APP_ENCRYPTION_KEY=

# The email server (sign-in links, password resets) is set in the app:
# Settings › Email (server admin), so changing provider is just a form.

# --- Quick routes (QR codes and short links) ---------------------------------
# The address customers use: quote links (/q/...), /verify/... and /go/<code>.
# Must be reachable from the internet for online quote signing. Blank = BETTER_AUTH_URL.
PUBLIC_LINK_BASE=
# Prefix for codes once this server joins the hub (leave blank for now).
INSTANCE_ID=

# --- Scheduled jobs -----------------------------------------------------------
# "off" stops scheduled jobs in this container (e.g. a second app container).
# The clean-up's own settings (days, on/off, time) are in the app:
# Settings › Storage.
JOBS=on

# --- Development only ---------------------------------------------------------
# Where uploads go outside Docker (the container always uses /data/files).
# FILES_ROOT=./data/files
